<%- include('partials/header') %>
<div class="space-y-10 px-4 sm:px-0">
  
  <!-- System Status Header -->
  <div class="glass-card p-10 flex flex-col lg:flex-row items-center justify-between relative overflow-hidden group">
    <div class="relative z-10">
      <h3 class="text-3xl font-black text-white italic tracking-tighter uppercase">Unified Telemetry</h3>
      <p class="text-slate-500 mt-2 font-medium">Real-time health from Lightspeed and WooCommerce nodes.</p>
    </div>
    <div class="mt-8 lg:mt-0 flex items-center space-x-4 relative z-10">
      <a href="/auth/lightspeed/manual" class="glass group flex items-center px-8 py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] text-white hover:bg-white/10 transition-all duration-300 border border-white/10 shadow-lg shadow-blue-500/10 active:scale-95">
        <svg class="w-4 h-4 mr-3 text-blue-500 group-hover:rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
        Link Lightspeed Token
      </a>
    </div>
    <!-- Abstract background shape -->
    <div class="absolute right-[-5%] top-[-10%] w-72 h-72 bg-blue-600/10 blur-[100px] -z-0 pointer-events-none group-hover:bg-blue-600/20 transition-all duration-700"></div>
  </div>

  <!-- Telemetry Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
    
    <!-- Lightspeed Status -->
    <div class="glass-card p-8 group hover:border-blue-500/30 transition-all duration-500">
      <div class="flex items-center justify-between">
        <div class="p-4 rounded-2xl bg-blue-500/10 text-blue-500 border border-blue-500/20">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <div class="flex items-center space-x-2 bg-emerald-500/10 px-3 py-1.5 rounded-full border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[9px] font-black text-emerald-500 uppercase tracking-widest">Stable</span>
        </div>
      </div>
      <div class="mt-10">
          <p class="text-3xl font-black text-white italic tracking-tighter uppercase whitespace-nowrap">Connected</p>
          <p class="text-[10px] font-black text-slate-600 uppercase tracking-[0.3em] mt-2">Retail X-Series</p>
      </div>
    </div>

    <!-- WooCommerce Status -->
    <div class="glass-card p-8 group hover:border-purple-500/30 transition-all duration-500">
      <div class="flex items-center justify-between">
        <div class="p-4 rounded-2xl bg-purple-500/10 text-purple-500 border border-purple-500/20">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
        </div>
        <div class="flex items-center space-x-2 bg-emerald-500/10 px-3 py-1.5 rounded-full border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[9px] font-black text-emerald-500 uppercase tracking-widest">Active</span>
        </div>
      </div>
      <div class="mt-10">
          <p class="text-3xl font-black text-white italic tracking-tighter uppercase">REST v3</p>
          <p class="text-[10px] font-black text-slate-600 uppercase tracking-[0.3em] mt-2">Core Commerce</p>
      </div>
    </div>

    <!-- Cloud SQL Monitor -->
    <div class="glass-card p-8 group hover:border-indigo-500/30 transition-all duration-500">
      <div class="flex items-center justify-between">
        <div class="p-4 rounded-2xl bg-indigo-500/10 text-indigo-500 border border-indigo-500/20">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 2 2 6 2s6 0 6-2V7M4 7c0 2 2 2 6 2s6 0 6-2M4 7c0-2 2-2 6-2s6 0 6 2m0 5c0 2 2 2 6 2s6 0 6-2"/>
          </svg>
        </div>
        <div class="text-[9px] font-black text-indigo-400 uppercase tracking-widest bg-indigo-500/10 px-3 py-1.5 rounded-full border border-indigo-500/20">SQL Relay</div>
      </div>
      <div class="mt-10">
        <p class="text-3xl font-black text-white italic tracking-tighter leading-none"><%= productCount %></p>
        <p class="text-[10px] font-black text-slate-600 uppercase tracking-[0.3em] mt-3">Variants Mirrored</p>
      </div>
    </div>

    <!-- Queue Engine -->
    <div class="glass-card p-8 group hover:border-orange-500/30 transition-all duration-500">
      <div class="flex items-center justify-between">
        <div class="p-4 rounded-2xl bg-orange-500/10 text-orange-500 border border-orange-500/20">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
        </div>
        <div class="text-[9px] font-black text-orange-400 uppercase tracking-widest bg-orange-500/10 px-3 py-1.5 rounded-full border border-orange-500/20">Latency OK</div>
      </div>
      <div class="mt-10">
        <p class="text-3xl font-black text-white italic tracking-tighter uppercase">Healthy</p>
        <p class="text-[10px] font-black text-slate-600 uppercase tracking-[0.3em] mt-2">Queue Logic</p>
      </div>
    </div>

  </div>

  <!-- Log Activity Table -->
  <div class="glass-card overflow-hidden">
    <div class="px-10 py-8 border-b border-white/5 flex justify-between items-end bg-white/[0.01]">
      <div>
        <h3 class="text-xl font-black text-white italic tracking-tighter uppercase">Audit Stream</h3>
        <p class="text-xs text-slate-500 font-medium mt-1">Real-time log of cross-platform state changes.</p>
      </div>
      <a href="/admin/logs" class="group flex items-center text-[10px] font-black text-blue-500 uppercase tracking-[0.3em] hover:text-white transition-colors">
        Full History
        <svg class="w-4 h-4 ml-3 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-white/[0.02]">
            <th class="px-8 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Timestamp</th>
            <th class="px-8 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Flow Direction</th>
            <th class="px-8 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Status</th>
            <th class="px-8 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Diagnostic ID</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% if (recentLogs && recentLogs.length > 0) { %>
            <% recentLogs.forEach(log => { %>
              <tr class="group hover:bg-white/[0.02] transition-colors">
                <td class="px-8 py-5">
                  <p class="text-sm font-medium text-white"><%= new Date(log.createdAt).toLocaleTimeString() %></p>
                  <p class="text-[10px] text-gray-500 font-bold uppercase"><%= new Date(log.createdAt).toLocaleDateString() %></p>
                </td>
                <td class="px-8 py-5">
                  <div class="flex items-center">
                    <div class="px-3 py-1 rounded-lg bg-gray-500/10 border border-white/5 text-[10px] font-bold text-gray-400 uppercase">
                      <%= log.direction %>
                    </div>
                  </div>
                </td>
                <td class="px-8 py-5">
                  <% if (log.status === 'completed') { %>
                    <div class="flex items-center space-x-2 text-green-500">
                      <div class="w-1.5 h-1.5 rounded-full bg-green-500"></div>
                      <span class="text-xs font-bold uppercase tracking-wider">Success</span>
                    </div>
                  <% } else if (log.status === 'failed') { %>
                    <div class="flex items-center space-x-2 text-red-500">
                      <div class="w-1.5 h-1.5 rounded-full bg-red-500"></div>
                      <span class="text-xs font-bold uppercase tracking-wider">Failed</span>
                    </div>
                  <% } else { %>
                    <div class="flex items-center space-x-2 text-yellow-500">
                      <div class="w-1.5 h-1.5 rounded-full bg-yellow-500 animate-pulse"></div>
                      <span class="text-xs font-bold uppercase tracking-wider">Pending</span>
                    </div>
                  <% } %>
                </td>
                <td class="px-8 py-5 text-gray-400 font-mono text-xs">
                  <span class="bg-gray-500/5 px-2 py-1 rounded border border-white/5"><%= log.id.substring(0, 12) %></span>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="px-8 py-20 text-center">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full bg-gray-500/10 flex items-center justify-center text-gray-500 mb-4">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0a2 2 0 01-2 2H6a2 2 0 01-2-2m16 0l-8 8-8-8"/>
                    </svg>
                  </div>
                  <p class="text-sm font-medium text-gray-500">No active sync events detected</p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>
<%- include('partials/footer') %>
