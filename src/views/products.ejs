<%- include('partials/header') %>
<div class="space-y-10 px-4 sm:px-0">
  
  <!-- Header & Actions -->
  <div class="glass-card p-10 flex flex-col lg:flex-row items-center justify-between relative overflow-hidden group">
    <div class="relative z-10">
      <h3 class="text-3xl font-black text-white italic tracking-tighter uppercase">Catalog</h3>
      <p class="text-slate-500 mt-2 font-medium">Page <%= page %> of <%= totalPages %> [<%= total %> total variants]</p>
    </div>
    <div class="mt-8 lg:mt-0 flex items-center space-x-4 relative z-10">
      <div class="flex space-x-2">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %>" class="glass px-6 py-4 rounded-xl text-[10px] font-black uppercase tracking-widest text-white hover:bg-white/10 transition-colors">← Prev</a>
        <% } %>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %>" class="glass px-6 py-4 rounded-xl text-[10px] font-black uppercase tracking-widest text-white hover:bg-white/10 transition-colors">Next →</a>
        <% } %>
      </div>
    </div>
    <div class="absolute right-[-5%] top-[-10%] w-72 h-72 bg-blue-600/10 blur-[100px] -z-0 pointer-events-none group-hover:bg-blue-600/20 transition-all duration-700"></div>
  </div>

  <!-- Product Table -->
  <div class="glass-card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead class="bg-white/[0.02]">
          <tr>
            <th class="px-8 py-5 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Product Detail</th>
            <th class="px-8 py-5 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">SKU & Identifiers</th>
            <th class="px-8 py-5 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Price / Stock</th>
            <th class="px-8 py-5 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">WooCommerce</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% products.forEach(p => { %>
            <tr class="group hover:bg-white/[0.02] transition-colors">
              <td class="px-8 py-6">
                <div class="flex items-center">
                  <div class="w-12 h-12 rounded-xl bg-gray-500/10 border border-white/10 flex items-center justify-center text-gray-600 shrink-0 overflow-hidden">
                    <% if (p.imageUrl) { %>
                      <img src="<%= p.imageUrl %>" class="w-full h-full object-cover" onerror="this.style.display='none'">
                    <% } else { %>
                      <span class="text-lg">📦</span>
                    <% } %>
                  </div>
                  <div class="ml-4">
                    <p class="text-sm font-bold text-white group-hover:text-blue-400 transition-colors"><%= p.title %></p>
                    <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wider mt-0.5"><%= p.category || 'No Category' %></p>
                  </div>
                </div>
              </td>
              <td class="px-8 py-6">
                <p class="text-xs font-mono text-blue-400"><%= p.sku || 'N/A' %></p>
                <% if (p.brand) { %>
                  <p class="text-[10px] text-gray-500 mt-1 uppercase font-bold"><%= p.brand %></p>
                <% } %>
              </td>
              <td class="px-8 py-6">
                <p class="text-sm font-bold text-white tracking-tight">$<%= parseFloat(p.price).toFixed(2) %></p>
                <p class="text-[10px] font-bold mt-1 <%= p.quantity > 0 ? 'text-emerald-500' : 'text-amber-500' %> uppercase tracking-widest">Stock: <%= p.quantity %></p>
              </td>
              <td class="px-8 py-6">
                <% const wooId = p.metadata && p.metadata.woocommerceId; %>
                <% if (wooId) { %>
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
                    <span class="text-[10px] font-black text-blue-400 uppercase tracking-widest">Live #<%= wooId %></span>
                  </div>
                <% } else { %>
                  <span class="text-[10px] font-bold text-slate-600 uppercase tracking-widest">Staged</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (products.length === 0) { %>
            <tr>
              <td colspan="4" class="px-8 py-20 text-center text-sm text-gray-500 uppercase tracking-widest">No products in staging database.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>
<%- include('partials/footer') %>
