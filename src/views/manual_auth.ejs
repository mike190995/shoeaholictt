<%- include('partials/header') %>
<div class="max-w-2xl mx-auto space-y-10 px-4 sm:px-0 pt-6">

  <!-- Header -->
  <div class="glass-card p-10 flex flex-col items-center text-center relative overflow-hidden group">
    <div class="relative z-10">
      <div class="w-16 h-16 rounded-3xl bg-blue-600/10 text-blue-500 border border-blue-500/20 flex items-center justify-center mx-auto mb-6 shadow-[0_0_30px_rgba(59,130,246,0.15)]">
        <svg class="w-8 h-8 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
      </div>
      <h3 class="text-3xl font-black text-white italic tracking-tighter uppercase">Lightspeed X Connection</h3>
      <p class="text-slate-500 mt-2 font-medium">Link your Private Application Personal Token to start syncing catalog data.</p>
    </div>
    <div class="absolute right-[-10%] top-[-20%] w-72 h-72 bg-blue-600/5 blur-[100px] -z-0 pointer-events-none"></div>
  </div>

  <% if (success) { %>
    <div class="p-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-start space-x-4">
      <svg class="w-6 h-6 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <div>
        <h4 class="font-bold text-white uppercase text-xs tracking-wider">Credentials Saved</h4>
        <p class="text-xs text-emerald-400/90 mt-1">Your Lightspeed X-Series Personal Token was saved and verified successfully. Catalog data can now be mirrored.</p>
      </div>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="p-6 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400 flex items-start space-x-4">
      <svg class="w-6 h-6 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <div>
        <h4 class="font-bold text-white uppercase text-xs tracking-wider">Save Failed</h4>
        <p class="text-xs text-red-400/90 mt-1"><%= error %></p>
      </div>
    </div>
  <% } %>

  <!-- Settings Form -->
  <div class="glass-card p-10">
    <form action="/auth/lightspeed/manual" method="POST" class="space-y-8">
      
      <!-- Account ID -->
      <div class="space-y-2">
        <label for="accountId" class="block text-[10px] font-black text-slate-400 uppercase tracking-widest">Store Domain / Account ID</label>
        <p class="text-xs text-slate-500">The sub-domain of your Lightspeed Retail (X-Series) store.</p>
        <div class="relative">
          <input 
            type="text" 
            name="accountId" 
            id="accountId" 
            required 
            placeholder="e.g. shoptt.retail.lightspeed.app" 
            value="<%= accountId || '' %>"
            class="w-full bg-white/[0.02] border border-white/10 rounded-2xl px-6 py-4 text-sm text-white placeholder-slate-600 focus:border-blue-500/50 focus:bg-white/[0.04] transition-all"
          />
        </div>
      </div>

      <!-- Token -->
      <div class="space-y-2">
        <label for="token" class="block text-[10px] font-black text-slate-400 uppercase tracking-widest">Personal Token</label>
        <p class="text-xs text-slate-500">Your Private Application Personal Token (starts with <code class="text-blue-400 font-mono">lsxs_pt_</code>).</p>
        <div class="relative">
          <input 
            type="password" 
            name="token" 
            id="token" 
            required 
            placeholder="lsxs_pt_..." 
            value="<%= token || '' %>"
            class="w-full bg-white/[0.02] border border-white/10 rounded-2xl px-6 py-4 text-sm text-white placeholder-slate-600 focus:border-blue-500/50 focus:bg-white/[0.04] transition-all font-mono"
          />
        </div>
      </div>

      <!-- Submit -->
      <div class="pt-4 flex items-center justify-between">
        <a href="/admin" class="text-xs font-bold text-slate-500 hover:text-white uppercase tracking-wider transition-colors">
          &larr; Back to Dashboard
        </a>
        <button 
          type="submit" 
          class="bg-blue-600 hover:bg-blue-500 text-white font-black uppercase text-[10px] tracking-[0.2em] px-8 py-4 rounded-2xl transition-all border border-blue-500/20 shadow-lg shadow-blue-600/20 active:scale-95"
        >
          Save & Verify Connection
        </button>
      </div>

    </form>
  </div>

  <!-- Instruction Block -->
  <div class="glass-card p-10 space-y-6">
    <div>
      <h4 class="text-sm font-black text-white uppercase tracking-wider mb-3">Staging Sandbox Credentials</h4>
      <p class="text-xs text-slate-400 leading-relaxed">If you are setting this up for staging or test environments, you can use the pre-configured sandbox store:</p>
      <div class="mt-3 bg-white/[0.02] border border-white/5 rounded-xl p-4 font-mono text-xs space-y-2 text-slate-300">
        <div><span class="text-slate-500">Store Domain:</span> shoptt.retail.lightspeed.app</div>
        <div class="break-all"><span class="text-slate-500">Personal Token:</span> lsxs_pt_76bc256d0d21096a67fdbf4e414c2438c8be373d</div>
      </div>
    </div>

    <hr class="border-white/5" />

    <div class="space-y-4">
      <h4 class="text-sm font-black text-white uppercase tracking-wider">How to generate your own Personal Token</h4>
      <ol class="list-decimal list-inside space-y-3 text-xs text-slate-400">
        <li>Log into your Lightspeed Retail (X-Series / Vend) account.</li>
        <li>Navigate to <strong class="text-white">Setup</strong> &rarr; <strong class="text-white">API Access</strong>.</li>
        <li>Under <strong class="text-white">Personal Tokens</strong>, click <strong class="text-white">Generate Personal Token</strong>.</li>
        <li>Provide a name (e.g., <code class="bg-white/5 px-2 py-0.5 rounded text-blue-400">LSWOO Local Middleware</code>).</li>
        <li>Copy the generated token key starting with <code class="text-blue-400 font-mono">lsxs_pt_</code> and paste it above.</li>
      </ol>
    </div>
  </div>


</div>
<%- include('partials/footer') %>
