<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LSWOO | Security Gate</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Outfit', sans-serif;
            background: radial-gradient(circle at 50% 0%, #1e293b 0%, #0a0a0b 100%);
            color: #f8fafc;
        }
        .glass {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .neon-border {
            position: relative;
        }
        .neon-border::after {
            content: '';
            position: absolute;
            inset: -1px;
            background: linear-gradient(45deg, #3b82f6, transparent, #3b82f6);
            border-radius: inherit;
            z-index: -1;
            opacity: 0.3;
        }
        .input-glass {
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }
        .input-glass:focus {
            border-color: #3b82f6;
            background: rgba(0, 0, 0, 0.4);
            outline: none;
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.2);
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-6">
    
    <div class="w-full max-w-md animate-in fade-in zoom-in duration-700">
        <!-- Branding -->
        <div class="flex flex-col items-center mb-10">
            <div class="w-16 h-16 bg-blue-600 rounded-[1.5rem] flex items-center justify-center text-3xl shadow-[0_0_30px_rgba(59,130,246,0.4)] mb-6 animate-pulse">
                ⚡
            </div>
            <h1 class="text-3xl font-black italic tracking-tighter uppercase text-white">Universal Portal</h1>
            <p class="text-slate-500 font-medium text-sm mt-1">Authorized Personnel Only</p>
        </div>

        <!-- Login Card -->
        <div class="glass rounded-[2rem] p-8 sm:p-10 relative overflow-hidden">
            <!-- Background Accent -->
            <div class="absolute top-0 right-0 w-32 h-32 bg-blue-600/10 blur-3xl -z-10"></div>
            
            <form action="/login" method="POST" class="space-y-6">
                <div class="space-y-4">
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] mb-2.5 ml-1">Admin Identity</label>
                        <input 
                            type="text" 
                            name="username" 
                            placeholder="admin / secret"
                            class="w-full input-glass rounded-2xl px-5 py-4 text-white font-medium placeholder:text-slate-700"
                            required
                        >
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] mb-2.5 ml-1">Access Key</label>
                        <input 
                            type="password" 
                            name="password" 
                            placeholder="••••••••••••"
                            class="w-full input-glass rounded-2xl px-5 py-4 text-white font-mono placeholder:text-slate-700"
                            required
                        >
                    </div>
                </div>

                <% if (error) { %>
                    <div class="flex items-center gap-3 bg-rose-500/10 border border-rose-500/20 rounded-xl px-4 py-3 animate-bounce">
                        <span class="text-rose-500">⚠️</span>
                        <p class="text-[11px] font-bold text-rose-400 uppercase tracking-wider"><%= error %></p>
                    </div>
                <% } %>

                <button 
                    type="submit" 
                    class="w-full bg-blue-600 hover:bg-blue-500 text-white font-black uppercase tracking-[0.2em] text-xs py-5 rounded-2xl transition-all shadow-lg shadow-blue-500/25 active:scale-[0.98]"
                >
                    Initialize Connection
                </button>
            </form>

            <div class="mt-8 pt-8 border-t border-white/5 flex justify-between items-center">
                <div class="flex items-center space-x-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Sys Ready</span>
                </div>
                <span class="text-[10px] font-bold text-slate-700 uppercase tracking-widest">LSWOO Middleware PRO</span>
            </div>
        </div>

        <p class="text-center mt-8 text-[10px] font-bold text-slate-600 uppercase tracking-[0.3em]">
            &copy; 2026 Senmizu Operations
        </p>
    </div>

</body>
</html>
