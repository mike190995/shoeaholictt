<%- include('partials/header') %>
<div class="space-y-10 px-4 sm:px-0">
  
  <!-- Header & Filters -->
  <div class="glass-card p-10 flex flex-col lg:flex-row items-center justify-between relative overflow-hidden group">
    <div class="relative z-10">
      <h3 class="text-3xl font-black text-white italic tracking-tighter uppercase">Sync Logs</h3>
      <p class="text-slate-500 mt-2 font-medium">Page <%= page %> of <%= totalPages %> — Real-time ledger of synchronization events.</p>
    </div>
    <div class="mt-8 lg:mt-0 flex flex-col sm:flex-row items-center gap-4 relative z-10">
      <div class="relative">
        <select onchange="window.location.href='?filter='+this.value" class="glass bg-white/5 border-white/10 rounded-2xl px-6 py-4 text-[10px] font-black uppercase tracking-[0.2em] text-blue-500 focus:ring-2 focus:ring-blue-500/50 appearance-none min-w-[200px] cursor-pointer hover:bg-white/10 transition-all">
          <option value="" <%= !filter ? 'selected' : '' %>>All Statuses</option>
          <option value="failed" <%= filter === 'failed' ? 'selected' : '' %>>Failed</option>
          <option value="pending" <%= filter === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="completed" <%= filter === 'completed' ? 'selected' : '' %>>Completed</option>
        </select>
        <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-blue-500/50">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>
      
      <div class="flex space-x-2">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %><%= filter ? '&filter=' + filter : '' %>" class="glass px-6 py-4 rounded-xl text-[10px] font-black uppercase tracking-widest text-white hover:bg-white/10 transition-colors">← Prev</a>
        <% } %>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %><%= filter ? '&filter=' + filter : '' %>" class="glass px-6 py-4 rounded-xl text-[10px] font-black uppercase tracking-widest text-white hover:bg-white/10 transition-colors">Next →</a>
        <% } %>
      </div>
    </div>
    <div class="absolute left-0 top-0 w-64 h-64 bg-indigo-600/10 blur-[100px] -z-0 pointer-events-none group-hover:bg-indigo-600/20 transition-all duration-700"></div>
  </div>

  <!-- Events Table -->
  <div class="glass-card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead class="bg-white/[0.02]">
          <tr>
            <th class="px-8 py-5 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Timestamp</th>
            <th class="px-8 py-5 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Direction</th>
            <th class="px-8 py-5 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Entity</th>
            <th class="px-8 py-5 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Outcome</th>
            <th class="px-8 py-5 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">Inspect</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% logs.forEach(log => { %>
            <tr class="group hover:bg-white/[0.02] transition-colors">
              <td class="px-8 py-6">
                <p class="text-sm font-medium text-white"><%= new Date(log.createdAt).toLocaleTimeString() %></p>
                <p class="text-[10px] text-gray-500 font-bold uppercase"><%= new Date(log.createdAt).toLocaleDateString() %></p>
              </td>
              <td class="px-8 py-6">
                <div class="px-3 py-1 rounded-lg bg-gray-500/10 border border-white/5 text-[10px] font-bold text-gray-400 uppercase inline-block">
                  <%= log.direction %>
                </div>
              </td>
              <td class="px-8 py-6">
                <div class="flex flex-col">
                  <span class="text-xs font-bold text-white uppercase tracking-wider"><%= log.entityType %></span> 
                  <span class="text-[10px] text-blue-500 font-mono mt-1 opacity-70"><%= log.entityId %></span>
                </div>
              </td>
              <td class="px-8 py-6">
                <% if (log.status === 'completed') { %>
                  <div class="flex items-center space-x-2 text-green-500">
                    <div class="w-1.5 h-1.5 rounded-full bg-green-500"></div>
                    <span class="text-[10px] font-bold uppercase tracking-widest">Success</span>
                  </div>
                <% } else if (log.status === 'failed' || log.status === 'error') { %>
                  <div class="flex items-center space-x-2 text-red-500">
                    <div class="w-1.5 h-1.5 rounded-full bg-red-500"></div>
                    <span class="text-[10px] font-bold uppercase tracking-widest">Failed</span>
                  </div>
                <% } else { %>
                  <div class="flex items-center space-x-2 text-yellow-500">
                    <div class="w-1.5 h-1.5 rounded-full bg-yellow-500 animate-pulse"></div>
                    <span class="text-[10px] font-bold uppercase tracking-widest">Pending</span>
                  </div>
                <% } %>
              </td>
              <td class="px-8 py-6">
                <button onclick="viewPayload('<%= log.id %>')" class="glass px-4 py-2 rounded-xl text-[10px] font-bold text-blue-500 uppercase tracking-widest hover:text-white hover:bg-blue-600/20 transition-all">
                  Inspect
                </button>
              </td>
            </tr>
          <% }) %>
          <% if (logs.length === 0) { %>
            <tr>
              <td colspan="5" class="px-8 py-20 text-center uppercase tracking-widest text-xs text-gray-500 font-bold">No sync events found for this filter</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Data Inspector Modal -->
<div id="payloadModal" class="hidden fixed inset-0 z-[100] overflow-hidden" role="dialog" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen px-4 pb-20 text-center sm:p-0">
    <div class="fixed inset-0 bg-black/80 backdrop-blur-xl transition-opacity" aria-hidden="true" onclick="closePayloadModal()"></div>
    <div class="inline-block glass bg-[#0a0a0b] rounded-[2.5rem] text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full border border-white/10 relative z-10">
      <div class="px-10 py-8 border-b border-white/5 flex justify-between items-center bg-white/[0.02]">
        <div>
          <h3 class="text-xl font-bold text-white tracking-tight" id="inspector-title">Log Inspector</h3>
          <p class="text-blue-500 text-[10px] font-bold uppercase tracking-[0.2em] mt-1">Raw Event Payload</p>
        </div>
        <button onclick="closePayloadModal()" class="w-10 h-10 rounded-full glass flex items-center justify-center text-gray-500 hover:text-white transition-colors">✕</button>
      </div>
      <div class="p-0 overflow-auto max-h-[60vh] bg-black/40">
        <div class="px-10 py-8">
          <pre id="payload-content" class="text-blue-400 font-mono text-sm leading-relaxed whitespace-pre-wrap"></pre>
        </div>
      </div>
      <div class="px-10 py-6 border-t border-white/5 bg-white/[0.02] flex justify-end">
        <button onclick="closePayloadModal()" class="glass bg-blue-600 hover:bg-blue-500 text-white px-8 py-3 rounded-2xl text-[10px] font-bold uppercase tracking-widest transition-all">
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  window.syncLogsData = <%- JSON.stringify(logs) %>;

  function viewPayload(logId) {
    const log = window.syncLogsData.find(l => l.id === logId);
    if (!log) return;
    
    document.getElementById('inspector-title').innerText = `${log.direction} // ${log.entityType} | ${log.entityId}`;
    
    let displayStr = '';
    try {
      if (log.status === 'failed' || log.status === 'error') {
        displayStr += `<span class="text-red-500 font-bold">// ERROR \\\\</span>\n\n`;
      }
      displayStr += `<span class="text-gray-500">// RAW PAYLOAD \\\\</span>\n` + JSON.stringify(log.payload, null, 2);
    } catch(e) {
      displayStr = "Payload decomposition failure.";
    }
    
    document.getElementById('payload-content').innerHTML = displayStr;
    document.getElementById('payloadModal').classList.remove('hidden');
  }

  function closePayloadModal() {
    document.getElementById('payloadModal').classList.add('hidden');
  }
</script>
<%- include('partials/footer') %>
