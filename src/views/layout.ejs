<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LSWOO | Premium Middleware</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-main: #0a0a0b;
      --bg-radial: radial-gradient(circle at 50% 0%, #1e293b 0%, #0a0a0b 100%);
      --bg-sidebar: #0e0e0f;
      --glass-bg: rgba(255, 255, 255, 0.03);
      --glass-border: rgba(255, 255, 255, 0.08);
      --accent-blue: #3b82f6;
      --text-muted: #64748b;
    }
    body { 
      font-family: 'Outfit', sans-serif;
      background: var(--bg-radial);
      background-attachment: fixed;
      color: #f8fafc;
    }
    .glass {
      background: var(--glass-bg);
      backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border);
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 2rem;
    }
    .sidebar-active {
      background: linear-gradient(90deg, rgba(59, 130, 246, 0.08) 0%, rgba(59, 130, 246, 0) 100%);
      border-left: 2px solid var(--accent-blue);
      color: white;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    input:focus, select:focus, button:focus {
      outline: none;
      box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }
  </style>
</head>
<body class="flex h-screen overflow-hidden bg-[#0a0a0b]">

  <!-- Mobile Overlay -->
  <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden lg:hidden"></div>
  
  <!-- Sidebar -->
  <aside id="mobile-sidebar" class="fixed inset-y-0 left-0 w-72 bg-[#0a0a0b]/40 backdrop-blur-2xl border-r border-white/5 flex flex-col h-full z-50 lg:relative lg:translate-x-0 sidebar-closed transition-transform duration-300">
    <div class="h-20 flex items-center px-10 border-b border-white/5 shrink-0">
      <a href="/admin" class="flex items-center space-x-3">
        <div class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center font-black text-xs shadow-[0_0_20px_rgba(59,130,246,0.3)] animate-pulse">⚡</div>
        <h1 class="text-xl font-black italic tracking-tighter uppercase text-white">LSWOO <span class="text-blue-500 font-medium">Core</span></h1>
      </a>
    </div>
    
    <nav class="flex-1 overflow-y-auto pt-8 px-6 space-y-1 no-scrollbar">
      <p class="px-4 text-[9px] font-black uppercase tracking-[0.3em] text-slate-600 mb-4 pt-2">Mission Control</p>
      
      <a href="/admin" class="group flex items-center px-5 py-3.5 text-[10px] font-black uppercase tracking-widest rounded-2xl transition-all duration-300 <%= activeTab === 'dashboard' ? 'sidebar-active shadow-lg shadow-blue-500/5' : 'text-slate-500 hover:text-white hover:bg-white/5' %>">
        <svg class="mr-4 h-4 w-4 <%= activeTab === 'dashboard' ? 'text-blue-500' : 'group-hover:text-blue-400' %> transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Health Monitor
      </a>

      <a href="/admin/import" class="group flex items-center px-5 py-3.5 text-[10px] font-black uppercase tracking-widest rounded-2xl transition-all duration-300 <%= activeTab === 'import' ? 'sidebar-active shadow-lg shadow-blue-500/5' : 'text-slate-500 hover:text-white hover:bg-white/5' %>">
        <svg class="mr-4 h-4 w-4 <%= activeTab === 'import' ? 'text-blue-500' : 'group-hover:text-blue-400' %> transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Import Node
      </a>

      <p class="px-4 text-[9px] font-black uppercase tracking-[0.3em] text-slate-600 mb-4 pt-6">Operations</p>

      <a href="/spreadsheet" class="group flex items-center px-5 py-3.5 text-[10px] font-black uppercase tracking-widest rounded-2xl transition-all duration-300 <%= activeTab === 'spreadsheet' ? 'sidebar-active shadow-lg shadow-blue-500/5' : 'text-slate-500 hover:text-white hover:bg-white/5' %>">
        <svg class="mr-4 h-4 w-4 <%= activeTab === 'spreadsheet' ? 'text-blue-500' : 'group-hover:text-blue-400' %> transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M10 3v18M6 3h12a3 3 0 013 3v12a3 3 0 01-3 3H6a3 3 0 01-3-3V6a3 3 0 013-3z"/>
        </svg>
        Spreadsheet
      </a>

      <a href="/mapper" class="group flex items-center px-5 py-3.5 text-[10px] font-black uppercase tracking-widest rounded-2xl transition-all duration-300 <%= activeTab === 'mapper' ? 'sidebar-active shadow-lg shadow-blue-500/5' : 'text-slate-500 hover:text-white hover:bg-white/5' %>">
        <svg class="mr-4 h-4 w-4 <%= activeTab === 'mapper' ? 'text-blue-500' : 'group-hover:text-blue-400' %> transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
        </svg>
        Category Mapper
      </a>

      <p class="px-4 text-[9px] font-black uppercase tracking-[0.3em] text-slate-600 mb-4 pt-6">Catalog</p>

      <a href="/admin/catalog" class="group flex items-center px-5 py-3.5 text-[10px] font-black uppercase tracking-widest rounded-2xl transition-all duration-300 <%= activeTab === 'products' ? 'sidebar-active shadow-lg shadow-blue-500/5' : 'text-slate-500 hover:text-white hover:bg-white/5' %>">
        <svg class="mr-4 h-4 w-4 <%= activeTab === 'products' ? 'text-blue-500' : 'group-hover:text-blue-400' %> transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        </svg>
        Product Catalog
      </a>

      <a href="/admin/sync" class="group flex items-center px-5 py-3.5 text-[10px] font-black uppercase tracking-widest rounded-2xl transition-all duration-300 <%= activeTab === 'sync' ? 'sidebar-active shadow-lg shadow-blue-500/5' : 'text-slate-500 hover:text-white hover:bg-white/5' %>">
        <svg class="mr-4 h-4 w-4 <%= activeTab === 'sync' ? 'text-blue-500' : 'group-hover:text-blue-400' %> transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        Manual Override
      </a>

      <a href="/admin/logs" class="group flex items-center px-5 py-3.5 text-[10px] font-black uppercase tracking-widest rounded-2xl transition-all duration-300 <%= activeTab === 'logs' ? 'sidebar-active shadow-lg shadow-blue-500/5' : 'text-slate-500 hover:text-white hover:bg-white/5' %>">
        <svg class="mr-4 h-4 w-4 <%= activeTab === 'logs' ? 'text-blue-500' : 'group-hover:text-blue-400' %> transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Audit Stream
      </a>
    </nav>

    <div class="p-8 border-t border-white/5 shrink-0">
      <div class="glass flex items-center p-4 rounded-2xl bg-white/[0.01]">
        <div class="h-10 w-10 rounded-xl bg-blue-600 flex items-center justify-center text-xs font-black shadow-lg shrink-0">⚡</div>
        <div class="ml-4">
          <p class="text-[10px] font-black text-white uppercase tracking-wider">Ops Admin</p>
          <p class="text-[9px] text-blue-500 font-bold uppercase tracking-widest">Connection Live</p>
        </div>
      </div>
    </div>
  </aside>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col h-full relative overflow-hidden">
    
    <!-- Top Bar -->
    <header class="h-20 border-b border-white/5 flex items-center justify-between px-6 lg:px-10 shrink-0 bg-[#0a0a0b]/80 backdrop-blur-md z-30">
      <div class="flex items-center">
        <button id="menu-toggle" class="p-2 mr-4 text-gray-400 hover:text-white lg:hidden">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
        <div class="flex flex-col">
          <h2 class="text-xl font-bold text-white tracking-tight"><%= title %></h2>
          <div class="flex items-center space-x-2">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
            <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Staging Environment</p>
          </div>
        </div>
      </div>
      
      <div class="flex items-center space-x-4">
        <div class="hidden sm:flex flex-col items-end mr-2">
          <p class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Cloud Run v14</p>
          <p class="text-[10px] text-blue-500">PROD READY</p>
        </div>
      </div>
    </header>

    <!-- Scrollable Content -->
    <main class="flex-1 overflow-auto p-1 lg:p-10 no-scrollbar relative">
      <div class="max-w-[1600px] mx-auto pb-20">
        <%- body %>
      </div>
      
      <!-- Background Accents -->
      <div class="fixed top-[-10%] right-[-10%] w-[40%] h-[40%] bg-blue-600/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>
      <div class="fixed bottom-[-5%] left-[-5%] w-[30%] h-[30%] bg-indigo-600/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>
    </main>
  </div>

  <script>
    const menuToggle = document.getElementById('menu-toggle');
    const mobileSidebar = document.getElementById('mobile-sidebar');
    const sidebarOverlay = document.getElementById('sidebar-overlay');

    function toggleMenu() {
      mobileSidebar.classList.toggle('sidebar-closed');
      mobileSidebar.classList.toggle('sidebar-open');
      sidebarOverlay.classList.toggle('hidden');
    }

    menuToggle.addEventListener('click', toggleMenu);
    sidebarOverlay.addEventListener('click', toggleMenu);
  </script>
</body>
</html>
